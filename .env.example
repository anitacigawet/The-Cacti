NODE_ENV=development
PORT=3002

# SQLite database path (relative to project root)
DATABASE_PATH=./data/app.db

# ─── Auth ──────────────────────────────────────────────────────────────────
# Google OAuth client. Create at: https://console.cloud.google.com/apis/credentials
# Application type: Web application.
# Authorized redirect URI for local dev: http://localhost:3002/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# JWT secret for session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating this logs out everyone.
JWT_SECRET=

# Public URL — used to build the OAuth callback URL.
# Local dev: http://localhost:3002
# Production: https://yourdomain.com
PUBLIC_URL=http://localhost:3002

# First sign-in by this email is auto-promoted to "owner" tier.
# Everyone else who signs in defaults to "invited".
OWNER_EMAIL=

# ─── Notifications (Resend) ────────────────────────────────────────────────
# Optional. If unset, alerts are logged to the server console only.
# Sign up at https://resend.com — free tier gives 3,000 emails/month.
# RESEND_FROM_EMAIL must be on a domain you've verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── LLM Providers ─────────────────────────────────────────────────────────
# The Cacti supports three providers. Configure as many as you like, then
# pick the active one in Settings. Env vars below are fallbacks — the Settings
# UI takes precedence when a value is set there.
#
# Default active provider (gemini | openai | deepseek). Settings UI overrides this.
LLM_PROVIDER=gemini

# Google Gemini — get your key at https://aistudio.google.com/app/apikey
# Docs: https://ai.google.dev/api
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DeepSeek — get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
