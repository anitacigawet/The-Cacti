{
  "name": "the-cacti",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Self-hosted civic reading and research workspace for Mohave County public records and regional news.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist/index.js",
    "dist/public/**",
    "config/data-sources.json",
    "drizzle/migrations/*.sql",
    ".env.example",
    "LICENSE",
    "README.md",
    "RUNTIME.md",
    "docs/CONFIGURATION.md",
    "docs/screenshots/the-cacti-banner.png",
    "docs/screenshots/the-cacti-newspaper.png",
    "run.bat",
    "run.sh"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/production.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "build:showroom": "cross-env VITE_SHOWROOM_MODE=1 vite build --outDir ../dist/showroom",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "release:stage": "pnpm build && node -e \"require('node:fs').rmSync('.release/runtime',{recursive:true,force:true})\" && pnpm --config.auto-install-peers=false --filter the-cacti deploy --prod --legacy .release/runtime"
  },
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "sql.js": "^1.14.1",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.3",
    "wouter": "^3.3.5"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping": "^2.10.31",
      "dompurify": "3.4.13",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "mdast-util-to-hast": "13.2.1",
      "mermaid": "11.16.1",
      "path-to-regexp": "0.1.13",
      "uuid@11.1.0": "11.1.1",
      "ws": "8.21.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
